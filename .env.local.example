# Copy to .env.local and fill in. Placeholders only; never commit real values.

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
ADMIN_EMAIL=you@example.com

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRO_PRICE_ID=price_...
STRIPE_PRO_YEARLY_PRICE_ID=price_...
STRIPE_FAMILY_PRICE_ID=price_...
STRIPE_FAMILY_YEARLY_PRICE_ID=price_...

# Email
RESEND_API_KEY=re_...

# Cross-product admin hub: shared secret ChoreStar sends to /api/admin/metrics
HUB_METRICS_TOKEN=
