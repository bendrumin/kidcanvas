# KidCanvas — App Store Connect listing and TestFlight lifecycle.
#
# Binaries are uploaded separately (xcodebuild -exportArchive with
# ExportOptions.plist in ios/, destination "upload"). These lanes manage the
# store listing and everything TestFlight needs, ported from SnapSweep so all
# three apps release the same way.

default_platform(:ios)

ASC_KEY_ID = "P8NYU5K555".freeze
ASC_ISSUER_ID = "69a6de6f-7e14-47e3-e053-5b8c7c11a4d1".freeze
ASC_KEY_PATH = "~/.appstoreconnect/private_keys/AuthKey_P8NYU5K555.p8".freeze

def asc_api_key
  app_store_connect_api_key(
    key_id: ASC_KEY_ID,
    issuer_id: ASC_ISSUER_ID,
    key_filepath: File.expand_path(ASC_KEY_PATH),
    in_house: false
  )
end

platform :ios do
  desc "Scan the metadata for common App Store rejection reasons."
  lane :check do
    precheck(api_key: asc_api_key, include_in_app_purchases: false)
  end

  desc "List the screenshots actually live on App Store Connect, per locale and"
  desc "device size. deliver's upload retry can leave duplicates behind, so this"
  desc "is the check after any screenshot push."
  lane :screenshot_audit do
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(**asc_api_key)
    app = Spaceship::ConnectAPI::App.find(
      CredentialsManager::AppfileConfig.try_fetch_value(:app_identifier)
    )
    version = app.get_edit_app_store_version(platform: Spaceship::ConnectAPI::Platform::IOS)
    UI.user_error!("No editable version on App Store Connect") if version.nil?
    UI.important("Editable version: #{version.version_string} (#{version.app_store_state})")

    total = 0
    duplicates = []
    version.get_app_store_version_localizations.each do |loc|
      loc.get_app_screenshot_sets.each do |set|
        names = set.app_screenshots.map(&:file_name).sort
        total += names.count
        UI.message("#{loc.locale} / #{set.screenshot_display_type}: #{names.count} screenshot(s)")
        names.each { |n| UI.message("    #{n}") }
        repeated = names.tally.select { |_, count| count > 1 }
        repeated.each do |name, count|
          duplicates << "#{loc.locale}/#{set.screenshot_display_type}: #{name} x#{count}"
        end
      end
    end

    if duplicates.empty?
      UI.success("No duplicate screenshots. #{total} total.")
    else
      UI.error("Duplicates found:")
      duplicates.each { |d| UI.error("  #{d}") }
    end
  end

  desc "Report the TestFlight beta groups and any public (open) join link."
  lane :testflight_link do
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(**asc_api_key)
    app = Spaceship::ConnectAPI::App.find(
      CredentialsManager::AppfileConfig.try_fetch_value(:app_identifier)
    )
    groups = app.get_beta_groups
    if groups.empty?
      UI.important("No beta groups yet.")
    end
    groups.each do |group|
      kind = group.is_internal_group ? "internal" : "external"
      UI.message("#{group.name} (#{kind}) id=#{group.id}")
      UI.message("   public link enabled: #{group.public_link_enabled.inspect}")
      UI.message("   public link:         #{group.public_link.inspect}")
      UI.message("   link limit:          #{group.public_link_limit.inspect}")
    end
    builds = Spaceship::ConnectAPI::Build.all(
      app_id: app.id, sort: "-version", limit: 5,
      includes: "betaAppReviewSubmission,preReleaseVersion"
    )
    builds.each do |build|
      review = build.beta_app_review_submission&.beta_review_state || "not submitted"
      UI.message("build #{build.version} — processing=#{build.processing_state} " \
                 "beta review=#{review}")
    end
    UI.important("External testers can only install once a build passes Beta App Review.")
  end

  desc "Show what Beta App Review still needs before an external build can ship:"
  desc "reviewer contact details, the app-level description, and What to Test."
  lane :beta_review_status do
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(**asc_api_key)
    app = Spaceship::ConnectAPI::App.find(
      CredentialsManager::AppfileConfig.try_fetch_value(:app_identifier)
    )

    detail = Spaceship::ConnectAPI.get_beta_app_review_detail(
      filter: { app: app.id }
    ).to_models.first
    UI.important("Beta App Review contact")
    if detail.nil?
      UI.message("   (no betaAppReviewDetail record yet)")
    else
      %w[contact_first_name contact_last_name contact_phone contact_email].each do |field|
        value = detail.send(field)
        state = (value.nil? || value.to_s.empty?) ? "MISSING" : value
        UI.message("   #{field}: #{state}")
      end
      UI.message("   demo_account_required: #{detail.demo_account_required.inspect}")
    end

    UI.important("App-level beta description (per locale)")
    app.get_beta_app_localizations.each do |loc|
      desc = loc.description.to_s.empty? ? "MISSING" : "#{loc.description[0, 60]}…"
      UI.message("   #{loc.locale}: #{desc}")
      UI.message("      feedback email: #{loc.feedback_email.inspect}")
    end

    build = Spaceship::ConnectAPI::Build.all(
      app_id: app.id, sort: "-version", limit: 1,
      includes: "betaAppReviewSubmission,betaBuildLocalizations"
    ).first
    UI.important("Newest build: #{build.version}")
    UI.message("   review state: #{build.beta_app_review_submission&.beta_review_state || 'not submitted'}")
    build.get_beta_build_localizations.each do |loc|
      whats_new = loc.whats_new.to_s.empty? ? "MISSING" : "#{loc.whats_new[0, 60]}…"
      UI.message("   what to test (#{loc.locale}): #{whats_new}")
    end
  end

  desc "Fill in the tester-facing TestFlight text: the app-level beta description"
  desc "and the newest build's What to Test."
  desc "e.g. fastlane ios beta_test_info feedback_email:you@example.com"
  lane :beta_test_info do |options|
    # Passed in rather than committed: this repo is public, and the address is
    # only meant to be seen by beta testers, not scraped off GitHub.
    feedback_email = options[:feedback_email].to_s
    UI.user_error!("Missing required option: feedback_email") if feedback_email.empty?

    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(**asc_api_key)
    app = Spaceship::ConnectAPI::App.find(
      CredentialsManager::AppfileConfig.try_fetch_value(:app_identifier)
    )

    description = File.read("beta/description.txt").strip
    whats_new = File.read("beta/whats_new.txt").strip

    existing = app.get_beta_app_localizations.find { |l| l.locale == "en-US" }
    attributes = { description: description, feedbackEmail: feedback_email }
    if existing
      Spaceship::ConnectAPI.patch_beta_app_localizations(
        localization_id: existing.id, attributes: attributes
      )
      UI.message("Updated app-level beta description (en-US)")
    else
      Spaceship::ConnectAPI.post_beta_app_localizations(
        app_id: app.id, attributes: attributes.merge(locale: "en-US")
      )
      UI.message("Created app-level beta description (en-US)")
    end

    build = Spaceship::ConnectAPI::Build.all(app_id: app.id, sort: "-version", limit: 1).first
    UI.user_error!("No build found") if build.nil?
    loc = build.get_beta_build_localizations.find { |l| l.locale == "en-US" }
    if loc
      Spaceship::ConnectAPI.patch_beta_build_localizations(
        localization_id: loc.id, attributes: { whatsNew: whats_new }
      )
      UI.message("Updated What to Test for build #{build.version}")
    else
      Spaceship::ConnectAPI.post_beta_build_localizations(
        build_id: build.id, attributes: { whatsNew: whats_new, locale: "en-US" }
      )
      UI.message("Created What to Test for build #{build.version}")
    end
    UI.success("Tester-facing text is set. Contact details still needed — see beta_submit.")
  end

  desc "Set the Beta App Review contact details and submit the newest build for"
  desc "review. Apple requires all four: first_name, last_name, phone, email."
  desc "e.g. fastlane ios beta_submit first_name:Ben last_name:Siegel phone:+15551234567 email:you@example.com"
  lane :beta_submit do |options|
    %i[first_name last_name phone email].each do |key|
      UI.user_error!("Missing required option: #{key}") if options[key].to_s.empty?
    end

    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(**asc_api_key)
    app = Spaceship::ConnectAPI::App.find(
      CredentialsManager::AppfileConfig.try_fetch_value(:app_identifier)
    )

    Spaceship::ConnectAPI.patch_beta_app_review_detail(
      app_id: app.id,
      attributes: {
        contactFirstName: options[:first_name],
        contactLastName: options[:last_name],
        contactPhone: options[:phone],
        contactEmail: options[:email],
        # KidCanvas has accounts, so Beta App Review gets the same demo login
        # App Review already uses (fastlane/metadata/review_information).
        demoAccountRequired: true,
        demoAccountName: File.read("metadata/review_information/demo_user.txt").strip,
        demoAccountPassword: File.read("metadata/review_information/demo_password.txt").strip,
        notes: File.read("beta/review_notes.txt").strip
      }
    )
    UI.message("Beta App Review contact saved.")

    build = Spaceship::ConnectAPI::Build.all(
      app_id: app.id, sort: "-version", limit: 1, includes: "betaAppReviewSubmission"
    ).first
    state = build.beta_app_review_submission&.beta_review_state
    if state && state != "REJECTED"
      UI.important("Build #{build.version} is already submitted (#{state}) — nothing to do.")
    else
      Spaceship::ConnectAPI.post_beta_app_review_submissions(build_id: build.id)
      UI.success("Submitted build #{build.version} for Beta App Review.")
    end
  end

  desc "Create (or reuse) an external TestFlight group with an open public join"
  desc "link, attach the newest build, and print the URL for the website."
  lane :testflight_public_link do
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(**asc_api_key)
    app = Spaceship::ConnectAPI::App.find(
      CredentialsManager::AppfileConfig.try_fetch_value(:app_identifier)
    )

    # Public links only exist on external groups; the default "Main" group is
    # internal and can never carry one.
    group = app.get_beta_groups.find { |g| !g.is_internal_group && g.name == "Public Beta" }
    if group.nil?
      UI.message("Creating external group 'Public Beta'…")
      group = Spaceship::ConnectAPI.create_beta_group(
        app_id: app.id,
        group_name: "Public Beta",
        is_internal_group: false,
        public_link_enabled: true,
        public_link_limit: 1_000,
        public_link_limit_enabled: true
      )
    elsif !group.public_link_enabled
      UI.message("Enabling public link on existing group…")
      group.update(attributes: { public_link_enabled: true })
    end

    # Re-read so the generated link is present.
    group = app.get_beta_groups.find { |g| g.id == group.id }

    build = Spaceship::ConnectAPI::Build.all(app_id: app.id, sort: "-version", limit: 1).first
    if build
      begin
        Spaceship::ConnectAPI.add_beta_groups_to_build(
          build_id: build.id, beta_group_ids: [group.id]
        )
        UI.success("Attached build #{build.version} to #{group.name}")
      rescue => e
        UI.important("Could not attach build #{build.version}: #{e.message}")
      end
    end

    if group.public_link
      UI.success("TestFlight public link: #{group.public_link}")
    else
      UI.important("Group created but no public link returned yet — re-run to pick it up.")
    end
  end

  desc "Delete duplicate screenshots left behind by a deliver upload retry,"
  desc "keeping one complete copy of each filename and restoring filename order."
  lane :screenshot_dedupe do
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(**asc_api_key)
    app = Spaceship::ConnectAPI::App.find(
      CredentialsManager::AppfileConfig.try_fetch_value(:app_identifier)
    )
    version = app.get_edit_app_store_version(platform: Spaceship::ConnectAPI::Platform::IOS)
    UI.user_error!("No editable version on App Store Connect") if version.nil?

    removed = 0
    version.get_app_store_version_localizations.each do |loc|
      loc.get_app_screenshot_sets.each do |set|
        keepers = {}
        set.app_screenshots.group_by(&:file_name).each do |name, shots|
          # Prefer a copy App Store Connect finished processing.
          sorted = shots.sort_by { |s| s.complete? ? 0 : 1 }
          keepers[name] = sorted.first
          sorted.drop(1).each do |dupe|
            UI.message("#{loc.locale}/#{set.screenshot_display_type}: deleting duplicate #{name} (#{dupe.id})")
            dupe.delete!
            removed += 1
          end
        end
        ordered = keepers.keys.sort.map { |n| keepers[n].id }
        set.reorder_screenshots(app_screenshot_ids: ordered)
        UI.message("#{loc.locale}/#{set.screenshot_display_type}: kept #{ordered.count} — #{keepers.keys.sort.join(', ')}")
      end
    end
    UI.success("Removed #{removed} duplicate screenshot(s).")
  end


  desc "Attach the newest processed build to the editable App Store version and"
  desc "submit it for App Review. DRY-RUNS by default and prints what it would"
  desc "do; only confirm:true actually submits."
  desc "e.g. fastlane ios release            # inspect"
  desc "     fastlane ios release confirm:true"
  lane :release do |options|
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(**asc_api_key)
    app = Spaceship::ConnectAPI::App.find(
      CredentialsManager::AppfileConfig.try_fetch_value(:app_identifier)
    )

    version = app.get_edit_app_store_version(platform: Spaceship::ConnectAPI::Platform::IOS)
    UI.user_error!("No editable App Store version — create one on App Store Connect first.") if version.nil?

    build = Spaceship::ConnectAPI::Build.all(app_id: app.id, sort: "-version", limit: 5)
                                        .find { |b| b.processing_state == "VALID" }
    UI.user_error!("No processed (VALID) build to attach.") if build.nil?

    UI.important("Version:  #{version.version_string} (#{version.app_store_state})")
    UI.important("Build:    #{build.version} (#{build.processing_state})")

    unless options[:confirm]
      UI.important("")
      UI.important("Dry run. This WOULD attach build #{build.version} to " \
                   "#{version.version_string} and submit it for App Review.")
      UI.important("Run again with confirm:true to do it.")
      next
    end

    version.select_build(build_id: build.id)
    UI.message("Attached build #{build.version} to #{version.version_string}.")

    # A ready (unsubmitted) review submission may already exist from a previous
    # attempt; reuse it rather than erroring on create.
    submission = app.get_ready_review_submission(
      platform: Spaceship::ConnectAPI::Platform::IOS, includes: "items"
    )
    submission ||= app.create_review_submission(platform: Spaceship::ConnectAPI::Platform::IOS)
    if submission.items.to_a.empty?
      submission.add_app_store_version_to_review_items(app_store_version_id: version.id)
    end
    submission.submit_for_review
    UI.success("Submitted #{version.version_string} (build #{build.version}) for App Review.")
  end


  desc "Count the testers in each TestFlight group -- the number the public"
  desc "link exists to move."
  lane :testers do
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(**asc_api_key)
    app = Spaceship::ConnectAPI::App.find(
      CredentialsManager::AppfileConfig.try_fetch_value(:app_identifier)
    )
    app.get_beta_groups.each do |group|
      testers = Spaceship::ConnectAPI.get_beta_testers(
        filter: { betaGroups: group.id }, limit: 200
      ).to_models
      kind = group.is_internal_group ? "internal" : "external"
      UI.message("#{group.name} (#{kind}): #{testers.count} tester(s)")
      testers.each { |t| UI.message("   #{t.email}") }
    end
  end


  desc "Everything App Review will ask for that TestFlight never did: version"
  desc "state, build, categories, age rating, pricing, and privacy labels."
  lane :release_audit do
    token = Spaceship::ConnectAPI::Token.create(**asc_api_key)
    Spaceship::ConnectAPI.token = token
    app = Spaceship::ConnectAPI::App.find(
      CredentialsManager::AppfileConfig.try_fetch_value(:app_identifier)
    )

    require "net/http"
    require "json"
    asc = lambda do |path|
      uri = URI("https://api.appstoreconnect.apple.com/v1/#{path}")
      req = Net::HTTP::Get.new(uri)
      req["Authorization"] = "Bearer #{token.text}"
      res = Net::HTTP.start(uri.hostname, uri.port, use_ssl: true) { |h| h.request(req) }
      parsed = JSON.parse(res.body)
      UI.error("GET #{path} -> #{res.code}") unless res.code.to_i.between?(200, 299)
      parsed
    end

    # get_edit_app_store_version returns nil once a version is locked for
    # review, so fall back to whatever the newest version record is.
    v = app.get_edit_app_store_version
    if v.nil?
      newest = asc.call("apps/#{app.id}/appStoreVersions?limit=3")["data"]&.first
      UI.important("Version: #{newest&.dig('attributes','versionString')} (#{newest&.dig('attributes','appStoreState')}) — locked, not editable")
      UI.message("  release type: #{newest&.dig('attributes','releaseType')}")
      v = Struct.new(:id).new(newest&.dig("id"))
    else
      UI.important("Version: #{v.version_string} (#{v.app_store_state})")
      rt = asc.call("appStoreVersions/#{v.id}")&.dig("data","attributes","releaseType")
      UI.message("  release type: #{rt}")
    end
    build = asc.call("appStoreVersions/#{v.id}/build")["data"]
    UI.message("  attached build: #{build ? build.dig('attributes', 'version') : 'NONE (the release lane attaches one)'}")

    infos = asc.call("apps/#{app.id}/appInfos?include=primaryCategory,secondaryCategory")
    editable = (infos["data"] || []).find { |i| i.dig("attributes", "appStoreState") != "READY_FOR_SALE" } || (infos["data"] || []).first
    prim = editable&.dig("relationships", "primaryCategory", "data", "id")
    sec = editable&.dig("relationships", "secondaryCategory", "data", "id")
    UI.important("Categories: #{prim || 'NONE SET'}#{sec ? " + #{sec}" : ''}")

    infos_a = asc.call("apps/#{app.id}/appInfos")["data"] || []
    info_a = infos_a.find { |i| i.dig("attributes", "appStoreState") != "READY_FOR_SALE" } || infos_a.first
    decl = asc.call("appInfos/#{info_a['id']}/ageRatingDeclaration")["data"]
    if decl.nil?
      UI.important("Age rating: MISSING")
    else
      set = decl["attributes"].reject { |_, val| val.nil? || val == false || val == "NONE" }
      UI.important("Age rating: #{set.empty? ? 'all NONE (4+)' : set.inspect}")
    end

    prices = asc.call("appPriceSchedules/#{app.id}/manualPrices?include=appPricePoint&limit=3")
    if (prices["data"] || []).empty?
      UI.important("Pricing: NOT SET")
    else
      pts = (prices["included"] || []).map { |x| x.dig("attributes", "customerPrice") }.compact.uniq
      UI.important("Pricing: set (#{pts.join(', ')})")
    end

    avail = asc.call("apps/#{app.id}/appAvailabilityV2?include=territoryAvailabilities&limit[territoryAvailabilities]=1")
    UI.important("Availability: #{avail['data'] ? 'configured' : 'NOT SET'}")

    # Apple exposes no REST path for privacy nutrition labels (every candidate
    # 404s), so this cannot be read back. It is set by hand in App Store
    # Connect once; app_privacy_details.json is the answer sheet.
    UI.important("Privacy labels: not readable via API — check App Store Connect > App Privacy")
  end


  desc "One-time App Store setup TestFlight never required: age rating (4+),"
  desc "free pricing, worldwide availability, and the content rights declaration."
  lane :release_prep do
    token = Spaceship::ConnectAPI::Token.create(**asc_api_key)
    Spaceship::ConnectAPI.token = token
    app = Spaceship::ConnectAPI::App.find(
      CredentialsManager::AppfileConfig.try_fetch_value(:app_identifier)
    )

    require "net/http"
    require "json"
    call = lambda do |method, path, body = nil, version: "v1"|
      uri = URI("https://api.appstoreconnect.apple.com/#{version}/#{path}")
      req = { "GET" => Net::HTTP::Get, "POST" => Net::HTTP::Post, "PATCH" => Net::HTTP::Patch }[method].new(uri)
      req["Authorization"] = "Bearer #{token.text}"
      if body
        req["Content-Type"] = "application/json"
        req.body = JSON.dump(body)
      end
      res = Net::HTTP.start(uri.hostname, uri.port, use_ssl: true) { |h| h.request(req) }
      parsed = res.body.to_s.empty? ? {} : JSON.parse(res.body)
      unless res.code.to_i.between?(200, 299)
        raise "#{method} #{path} -> #{res.code}: #{(parsed['errors'] || []).map { |e| e['detail'] || e['title'] }.join('; ')[0, 300]}"
      end
      parsed
    end

    # 1. Age rating: everything NONE/false, which is a 4+ rating. The
    # declaration moved from appStoreVersions to appInfos in the current API.
    infos = call.call("GET", "apps/#{app.id}/appInfos")
    info = (infos["data"] || []).find { |i| i.dig("attributes", "appStoreState") != "READY_FOR_SALE" } || infos["data"].first
    decl = call.call("GET", "appInfos/#{info['id']}/ageRatingDeclaration")
    decl_id = decl.dig("data", "id")
    UI.user_error!("no ageRatingDeclaration id found") unless decl_id
    call.call("PATCH", "ageRatingDeclarations/#{decl_id}", {
      data: { type: "ageRatingDeclarations", id: decl_id, attributes: {
        alcoholTobaccoOrDrugUseOrReferences: "NONE", contests: "NONE",
        gamblingSimulated: "NONE", horrorOrFearThemes: "NONE",
        matureOrSuggestiveThemes: "NONE", medicalOrTreatmentInformation: "NONE",
        profanityOrCrudeHumor: "NONE", sexualContentGraphicAndNudity: "NONE",
        sexualContentOrNudity: "NONE", violenceCartoonOrFantasy: "NONE",
        violenceRealistic: "NONE", violenceRealisticProlongedGraphicOrSadistic: "NONE",
        gambling: false, unrestrictedWebAccess: false, kidsAgeBand: nil,
        # newer questionnaire fields the API now requires
        gunsOrOtherWeapons: "NONE", lootBox: false, parentalControls: false,
        # families post artwork and comments to each other; moderation exists
        # (delete any comment, remove members), which review checks against this
        userGeneratedContent: true,
        # comments on family artwork are UGC above, not a messaging feature
        advertising: false, healthOrWellnessTopics: false,
        messagingAndChat: false, ageAssurance: false
      } }
    })
    UI.success("Age rating: declared, all NONE (4+)")

    # 2. Pricing: free, USD base.
    pts = call.call("GET", "apps/#{app.id}/appPricePoints?filter[territory]=USA&limit=8")
    zero = (pts["data"] || []).find { |x| x.dig("attributes", "customerPrice").to_f.zero? }
    UI.user_error!("no zero price point found") unless zero
    call.call("POST", "appPriceSchedules", {
      data: { type: "appPriceSchedules", relationships: {
        app: { data: { type: "apps", id: app.id } },
        baseTerritory: { data: { type: "territories", id: "USA" } },
        manualPrices: { data: [{ type: "appPrices", id: "${price-free}" }] }
      } },
      included: [{ type: "appPrices", id: "${price-free}",
        attributes: { startDate: nil },
        relationships: { appPricePoint: { data: { type: "appPricePoints", id: zero["id"] } } } }]
    })
    UI.success("Pricing: free (USD 0.00 base, all territories follow)")

    # 3. Availability: every territory, and new ones as Apple adds them.
    territories = []
    path = "territories?limit=200"
    loop do
      page = call.call("GET", path)
      territories += (page["data"] || []).map { |t| t["id"] }
      nxt = page.dig("links", "next")
      break unless nxt
      path = nxt.split("/v1/").last
    end
    call.call("POST", "appAvailabilities", {
      data: { type: "appAvailabilities",
        attributes: { availableInNewTerritories: true },
        relationships: {
          app: { data: { type: "apps", id: app.id } },
          territoryAvailabilities: { data: territories.map { |t| { type: "territoryAvailabilities", id: "${#{t}}" } } }
        } },
      included: territories.map { |t|
        { type: "territoryAvailabilities", id: "${#{t}}",
          attributes: { available: true },
          relationships: { territory: { data: { type: "territories", id: t } } } }
      }
    }, version: "v2")
    UI.success("Availability: #{territories.count} territories, new ones included")

    # 4. Content rights: no third-party content.
    call.call("PATCH", "apps/#{app.id}", {
      data: { type: "apps", id: app.id,
              attributes: { contentRightsDeclaration: "DOES_NOT_USE_THIRD_PARTY_CONTENT" } }
    })
    UI.success("Content rights: does not use third-party content")
  end


  desc "Publish the App Privacy nutrition labels from app_privacy_details.json."
  desc "Honest and short: account email, name, photos, stories, and the user id,"
  desc "all for app functionality, linked to the account, nothing for tracking."
  lane :privacy_labels do
    UI.user_error!(
      "Apple has no API for privacy nutrition labels: every candidate REST " \
      "path 404s, and fastlane's uploader needs an interactive Apple ID login. " \
      "Enter them once in App Store Connect -> App Privacy, using " \
      "fastlane/app_privacy_details.json as the answer sheet."
    )
  end




  desc "Update the live listing's promotional text. This is the one store field"
  desc "Apple lets you change without shipping a new version or a review."
  lane :promo_text do
    token = Spaceship::ConnectAPI::Token.create(**asc_api_key)
    Spaceship::ConnectAPI.token = token
    app = Spaceship::ConnectAPI::App.find(
      CredentialsManager::AppfileConfig.try_fetch_value(:app_identifier)
    )
    require "net/http"
    require "json"
    call = lambda do |method, path, body = nil|
      uri = URI("https://api.appstoreconnect.apple.com/v1/#{path}")
      req = { "GET" => Net::HTTP::Get, "PATCH" => Net::HTTP::Patch }[method].new(uri)
      req["Authorization"] = "Bearer #{token.text}"
      if body
        req["Content-Type"] = "application/json"
        req.body = JSON.dump(body)
      end
      res = Net::HTTP.start(uri.hostname, uri.port, use_ssl: true) { |h| h.request(req) }
      parsed = res.body.to_s.empty? ? {} : JSON.parse(res.body)
      raise "#{method} #{path} -> #{res.code}: #{(parsed['errors'] || []).map { |e| e['detail'] }.join('; ')[0, 250]}" unless res.code.to_i.between?(200, 299)
      parsed
    end

    text = File.read(File.join(File.dirname(__FILE__), "metadata/en-US/promotional_text.txt")).strip
    versions = call.call("GET", "apps/#{app.id}/appStoreVersions?limit=5")["data"]
    live = versions.find { |v| %w[READY_FOR_SALE PENDING_DEVELOPER_RELEASE].include?(v.dig("attributes", "appStoreState")) } || versions.first
    locs = call.call("GET", "appStoreVersions/#{live['id']}/appStoreVersionLocalizations")["data"]
    en = locs.find { |l| l.dig("attributes", "locale") == "en-US" } || locs.first
    call.call("PATCH", "appStoreVersionLocalizations/#{en['id']}", {
      data: { type: "appStoreVersionLocalizations", id: en["id"],
              attributes: { promotionalText: text } }
    })
    UI.success("Promotional text updated on #{live.dig('attributes', 'versionString')} (#{live.dig('attributes', 'appStoreState')})")
  end


  desc "Apple's own timestamps for this app: when the record was created and"
  desc "when each early build was uploaded. Evidence of first use of the name."
  lane :first_use do
    token = Spaceship::ConnectAPI::Token.create(**asc_api_key)
    Spaceship::ConnectAPI.token = token
    app = Spaceship::ConnectAPI::App.find(
      CredentialsManager::AppfileConfig.try_fetch_value(:app_identifier)
    )
    require "net/http"
    require "json"
    get = lambda do |path|
      uri = URI("https://api.appstoreconnect.apple.com/v1/#{path}")
      req = Net::HTTP::Get.new(uri)
      req["Authorization"] = "Bearer #{token.text}"
      JSON.parse(Net::HTTP.start(uri.hostname, uri.port, use_ssl: true) { |h| h.request(req) }.body)
    end
    UI.important("App id #{app.id} (#{app.bundle_id})")
    builds = get.call("apps/#{app.id}/builds?limit=200&fields[builds]=version,uploadedDate,expired")["data"] || []
    sorted = builds.sort_by { |b| b.dig("attributes", "uploadedDate").to_s }
    sorted.first(4).each do |b|
      UI.message("  build #{b.dig('attributes','version')}  uploaded #{b.dig('attributes','uploadedDate')}")
    end
    UI.message("  ... #{builds.count} builds total")
    vers = get.call("apps/#{app.id}/appStoreVersions?limit=20&fields[appStoreVersions]=versionString,createdDate,appStoreState")["data"] || []
    vers.sort_by { |v| v.dig("attributes","createdDate").to_s }.first(2).each do |v|
      UI.message("  version #{v.dig('attributes','versionString')} record created #{v.dig('attributes','createdDate')}")
    end
  end




  desc "Turn on the Developer Portal capabilities the widget and push need."
  desc "Additive and idempotent; prints what it changed."
  lane :enable_capabilities do
    token = Spaceship::ConnectAPI::Token.create(**asc_api_key)
    require "net/http"
    require "json"
    call = lambda do |method, path, body = nil|
      uri = URI("https://api.appstoreconnect.apple.com/v1/#{path}")
      klass = { "GET" => Net::HTTP::Get, "POST" => Net::HTTP::Post, "PATCH" => Net::HTTP::Patch }[method]
      req = klass.new(uri)
      req["Authorization"] = "Bearer #{token.text}"
      if body
        req["Content-Type"] = "application/json"
        req.body = JSON.dump(body)
      end
      res = Net::HTTP.start(uri.hostname, uri.port, use_ssl: true) { |h| h.request(req) }
      parsed = res.body.to_s.empty? ? {} : JSON.parse(res.body)
      [res.code.to_i, parsed]
    end

    want = {
      "Siegel.KidCanvas" => %w[PUSH_NOTIFICATIONS APP_GROUPS],
      "Siegel.KidCanvas.Widget" => %w[APP_GROUPS],
    }

    want.each do |identifier, capabilities|
      code, body = call.call("GET", "bundleIds?filter[identifier]=#{identifier}&include=bundleIdCapabilities&limit=5")
      entry = (body["data"] || []).find { |b| b.dig("attributes", "identifier") == identifier }

      if entry.nil?
        UI.important("#{identifier}: not registered, creating")
        code, body = call.call("POST", "bundleIds", {
          data: { type: "bundleIds", attributes: {
            identifier: identifier,
            name: identifier.tr(".", " "),
            platform: "IOS",
          } }
        })
        if code.between?(200, 299)
          entry = body["data"]
          UI.success("  created #{identifier}")
        else
          UI.error("  create failed: #{(body['errors'] || []).map { |e| e['detail'] }.join('; ')[0, 200]}")
          next
        end
      end

      existing = (body["included"] || []).map { |c| c.dig("attributes", "capabilityType") }.compact
      UI.message("#{identifier}: has #{existing.empty? ? 'none' : existing.uniq.join(', ')}")

      capabilities.each do |cap|
        if existing.include?(cap)
          UI.message("  #{cap} already on")
          next
        end
        c, b = call.call("POST", "bundleIdCapabilities", {
          data: { type: "bundleIdCapabilities",
                  attributes: { capabilityType: cap },
                  relationships: { bundleId: { data: { type: "bundleIds", id: entry["id"] } } } }
        })
        if c.between?(200, 299)
          UI.success("  enabled #{cap}")
        else
          UI.error("  #{cap} failed (#{c}): #{(b['errors'] || []).map { |e| e['detail'] || e['title'] }.join('; ')[0, 220]}")
        end
      end
    end
  end


  desc "What can this API key see and do for signing?"
  lane :signing_probe do
    token = Spaceship::ConnectAPI::Token.create(**asc_api_key)
    require "net/http"
    require "json"
    get = lambda do |path|
      uri = URI("https://api.appstoreconnect.apple.com/v1/#{path}")
      req = Net::HTTP::Get.new(uri)
      req["Authorization"] = "Bearer #{token.text}"
      res = Net::HTTP.start(uri.hostname, uri.port, use_ssl: true) { |h| h.request(req) }
      [res.code.to_i, (res.body.to_s.empty? ? {} : JSON.parse(res.body))]
    end
    [["certificates?limit=10", "certificates"],
     ["profiles?limit=20&include=bundleId", "profiles"],
     ["devices?limit=5", "devices"]].each do |path, label|
      code, body = get.call(path)
      if code == 200
        rows = body["data"] || []
        UI.important("#{label}: #{rows.count}")
        rows.first(8).each do |r|
          a = r["attributes"] || {}
          UI.message("  #{a['name'] || a['certificateType'] || r['id']}  #{a['profileType'] || a['certificateType'] || ''}  #{a['profileState'] || ''}")
        end
      else
        UI.error("#{label}: HTTP #{code} #{(body['errors'] || []).map { |e| e['detail'] }.join('; ')[0,150]}")
      end
    end
  end




  desc "Attach the newest processed build to the internal tester groups."
  desc "Internal testers need no beta review, so this is the fast path to a device."
  lane :internal_build do
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(**asc_api_key)
    app = Spaceship::ConnectAPI::App.find(
      CredentialsManager::AppfileConfig.try_fetch_value(:app_identifier)
    )
    build = Spaceship::ConnectAPI::Build.all(app_id: app.id, sort: "-version", limit: 5)
                                        .find { |b| b.processing_state == "VALID" }
    UI.user_error!("no processed build") if build.nil?
    app.get_beta_groups.select(&:is_internal_group).each do |group|
      already = build.get_beta_groups.map(&:id).include?(group.id) rescue false
      if already
        UI.message("#{group.name}: build #{build.version} already attached")
      else
        build.add_beta_groups(beta_groups: [group])
        UI.success("#{group.name}: attached build #{build.version}")
      end
    end
  end

  desc "Upload metadata and screenshots to App Store Connect. No binary."
  desc "Options: force:true skips the HTML preview; skip_screenshots:true for text only;"
  desc "app_version:1.0.1 creates that version on App Store Connect if it does not exist."
  lane :metadata do |options|
    skip_screenshots = options.fetch(:skip_screenshots, false)
    deliver(
      api_key: asc_api_key,
      skip_binary_upload: true,
      app_version: options[:app_version],
      skip_app_version_update: options[:app_version].nil?,
      skip_screenshots: skip_screenshots,
      overwrite_screenshots: true,
      force: options.fetch(:force, false),
      run_precheck_before_submit: false,
      precheck_include_in_app_purchases: false
    )
    # deliver re-checks its own uploads before App Store Connect has indexed
    # them, decides they failed, and retries — leaving a second copy of every
    # screenshot behind. It still exits successfully, so clean up unconditionally
    # rather than trusting the result.
    screenshot_dedupe unless skip_screenshots
  end
end
