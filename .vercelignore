# The Vercel CLI reads THIS file, not .gitignore. Without it, `vercel --prod`
# uploaded everything not in Vercel's small default ignore list -- including
# ios/build, which is ~17,000 files of Xcode derived data. That pushed the deploy
# past Vercel's 15,000-file limit.
#
# Every pattern here is anchored with a leading slash so it matches only the
# top-level directory. An unanchored pattern matches a directory of that name at
# ANY depth: a bare `supabase` also excluded lib/supabase/, which broke the build
# with "Can't resolve '@/lib/supabase/client'". Likewise a bare `scripts` would
# take out any nested scripts directory.

# Native app: ~17k files of build output, none of which the web build reads
/ios

# Separately-deployed static marketing site (has its own vercel.json)
/site

# Playwright: tests, config, reports, traces
/e2e
/playwright.config.ts
/test-results
/playwright-report
/blob-report
/playwright

# Database migrations and one-off SQL, applied out-of-band.
# NOTE: anchored -- lib/supabase/ is application code and must ship.
/supabase
/scripts

# Documentation and planning
/docs

# Local tooling
/.claude
/screenshots
